# Copy to .env.local and fill in. Leave the Supabase values empty to run on built-in sample data.

# Supabase project URL (Project Settings → API / Data API)
SUPABASE_URL=

# Supabase secret key: the new "sb_secret_..." key, or the legacy service_role key.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=

# Timezone used to display dates (optional, default America/New_York)
APP_TIMEZONE=America/New_York
